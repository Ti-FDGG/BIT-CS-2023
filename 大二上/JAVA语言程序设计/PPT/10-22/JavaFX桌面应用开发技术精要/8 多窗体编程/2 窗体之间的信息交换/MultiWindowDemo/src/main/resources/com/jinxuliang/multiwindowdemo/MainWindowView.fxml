<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="384.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8.0.111"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jinxuliang.multiwindowdemo.controllers.MainWindowController">
   <children>
      <VBox layoutX="80.0" layoutY="20.0" prefHeight="80.0" prefWidth="280.0" spacing="20.0">
         <children>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#showNewWindow" prefHeight="30.0" prefWidth="275.0" text="显示一个新窗体" />
            <Button fx:id="btnChangeWindow" mnemonicParsing="false" onAction="#changeWindow" prefHeight="30.0" prefWidth="275.0" text="动态更换主窗口内容" />
            <Line endX="170.0" startX="-100.0" />
            <TextField fx:id="userInput" />
            <Button fx:id="btnShowNewWindow" mnemonicParsing="false" onAction="#mainToOther" prefHeight="30.0" prefWidth="276.0" text="主窗体向新窗口传送信息" />
            <Line endX="170.0" startX="-100.0" />
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#showThirdWindow" prefHeight="30.0" prefWidth="279.0" text="主窗体从新窗口中接收信息" />
            <Label fx:id="messageLabel" text="无" textFill="#4106e4">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font></Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
