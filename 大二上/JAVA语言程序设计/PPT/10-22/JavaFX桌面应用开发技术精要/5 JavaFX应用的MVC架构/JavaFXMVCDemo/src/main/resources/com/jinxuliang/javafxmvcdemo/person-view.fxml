<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<AnchorPane prefHeight="133.0" prefWidth="600.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.jinxuliang.javafxmvcdemo.PersonController">

    <children>

        <Label fx:id="label"
               alignment="CENTER" layoutY="32.0" text="Hello,JavaFX!"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <font>
                <Font size="21.0"/>
            </font>
        </Label>

        <HBox alignment="CENTER" layoutX="14.0" layoutY="81.0" spacing="20.0"
              AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="-14.0">
            <children>
                <TextField fx:id="field" layoutX="69.0" layoutY="210.0"/>

                <Button layoutX="300.0" layoutY="210.0"
                        mnemonicParsing="false"
                        onAction="#handleButtonClick"
                        text="Change Text"/>

            </children>
        </HBox>
    </children>

</AnchorPane>