<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="362.0" prefWidth="383.0"
            xmlns="http://javafx.com/javafx/8.0.111"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jinxuliang.progressdemo.MainController">
   <children>
      <Button fx:id="btnIncrease" layoutX="77.0" layoutY="278.0" mnemonicParsing="false" text="+">
         <font>
            <Font size="29.0" />
         </font>
      </Button>
      <Button fx:id="btnDecrease" layoutX="268.0" layoutY="278.0" mnemonicParsing="false" text="-">
         <font>
            <Font size="29.0" />
         </font>
      </Button>
      <ProgressBar fx:id="progressBar" layoutX="76.0" layoutY="220.0" prefHeight="35.0" prefWidth="246.0" progress="0.0" />
      <ProgressIndicator fx:id="progressIndicator" layoutX="92.0" layoutY="14.0" prefHeight="200.0" prefWidth="200.0" progress="0.0" AnchorPane.bottomAnchor="148.0" AnchorPane.leftAnchor="90.0" AnchorPane.rightAnchor="90.0" AnchorPane.topAnchor="10.0" />
      <Label fx:id="lblInfo" layoutX="170.0" layoutY="291.0" text="0%" textFill="#e10707">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
